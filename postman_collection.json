{
  "info": {
    "name": "PetCare Hub API",
    "description": "Complete Postman collection for PetCare Hub – Smart Pet Management System. Import this alongside the 'PetCare Hub Local' environment. Run 'Login' first (or 'Register') to auto-populate the {{token}} variable used by every other request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "petId", "value": "", "type": "string" },
    { "key": "vaccinationId", "value": "", "type": "string" },
    { "key": "medicalRecordId", "value": "", "type": "string" },
    { "key": "medicineId", "value": "", "type": "string" },
    { "key": "appointmentId", "value": "", "type": "string" },
    { "key": "expenseId", "value": "", "type": "string" },
    { "key": "documentId", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Jane Doe\",\n  \"email\": \"jane.doe@example.com\",\n  \"password\": \"Password123\",\n  \"phone\": \"+1 555 123 4567\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201) {",
                "  const data = pm.response.json();",
                "  pm.collectionVariables.set('token', data.token);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@petcarehub.dev\",\n  \"password\": \"Demo@1234\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 200) {",
                "  const data = pm.response.json();",
                "  pm.collectionVariables.set('token', data.token);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Get Current User",
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/me",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Alex Morgan\",\n  \"phone\": \"+1 555 234 7890\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Pets",
      "item": [
        {
          "name": "List My Pets",
          "request": { "method": "GET", "url": "{{baseUrl}}/pets" }
        },
        {
          "name": "Create Pet",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/pets",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Buddy\",\n  \"species\": \"Dog\",\n  \"breed\": \"Golden Retriever\",\n  \"gender\": \"Male\",\n  \"dateOfBirth\": \"2022-05-14\",\n  \"weightKg\": 28.5,\n  \"color\": \"Golden\",\n  \"microchipId\": \"985121054327618\",\n  \"notes\": \"Loves the park.\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201) {",
                "  const data = pm.response.json();",
                "  pm.collectionVariables.set('petId', data.id);",
                "}"
              ]
            }
          }]
        },
        {
          "name": "Get Pet By Id",
          "request": { "method": "GET", "url": "{{baseUrl}}/pets/{{petId}}" }
        },
        {
          "name": "Update Pet",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/pets/{{petId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Buddy\",\n  \"species\": \"Dog\",\n  \"breed\": \"Golden Retriever\",\n  \"gender\": \"Male\",\n  \"dateOfBirth\": \"2022-05-14\",\n  \"weightKg\": 29.0,\n  \"color\": \"Golden\",\n  \"microchipId\": \"985121054327618\",\n  \"notes\": \"Updated weight after vet visit.\"\n}"
            }
          }
        },
        {
          "name": "Delete Pet",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/pets/{{petId}}" }
        }
      ]
    },
    {
